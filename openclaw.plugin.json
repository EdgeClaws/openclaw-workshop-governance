{
  "id": "workshop-governance-context",
  "name": "Workshop Governance Context",
  "version": "0.2.0",
  "description": "Loads canonical lifecycle guidance, workspace authorization/publication policy, and the current skill-owner index into autonomous Skill Workshop reviews.",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceDir": {
        "type": "string",
        "minLength": 1
      },
      "lifecycleSkillPath": {
        "type": "string",
        "minLength": 1,
        "default": "skills/openclaw-skill-plugin-lifecycle/SKILL.md"
      },
      "workspaceSkillRegistryPath": {
        "type": "string",
        "minLength": 1,
        "default": "skills/openclaw-skill-plugin-lifecycle/references/workspace-skill-registry.json"
      }
    }
  }
}
