{
  "id": "workshop-governance-context",
  "name": "Workshop Governance Context",
  "version": "0.2.0",
  "description": "Loads canonical lifecycle guidance, authority/publication registries, and the current workspace skill inventory into autonomous Skill Workshop reviews.",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceDir": {
        "type": "string",
        "minLength": 1
      },
      "lifecycleSkillPath": {
        "type": "string",
        "minLength": 1,
        "default": "skills/openclaw-skill-plugin-lifecycle/SKILL.md"
      },
      "governanceReferencePaths": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": [
          "skills/openclaw-skill-plugin-lifecycle/references/authoring-ownership.json",
          "skills/openclaw-skill-plugin-lifecycle/references/repository-publication.json"
        ]
      }
    }
  }
}
