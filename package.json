{
  "name": "@edgeclaws/openclaw-workshop-governance",
  "version": "0.1.1",
  "type": "module",
  "description": "Inject canonical lifecycle governance into autonomous Skill Workshop reviews.",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "openclaw": {
